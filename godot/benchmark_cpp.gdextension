[configuration]
entry_symbol = "gdext_cpp_init"
; Должно совпадать с api_version в custom.py: биндинги генерируются под эту
; версию GDExtension API.
compatibility_minimum = 4.7
reloadable = true

[libraries]
linux.debug.x86_64 =      "res://bin/libgdbenchmark.linux.template_debug.x86_64.so"
linux.release.x86_64 =    "res://bin/libgdbenchmark.linux.template_release.so"
windows.debug.x86_64 =    "res://bin/libgdbenchmark.windows.template_debug.x86_64.dll"
windows.release.x86_64 =  "res://bin/libgdbenchmark.windows.template_release.x86_64.dll"
macos.debug.universal =   "res://bin/libbenchmark_cpp.dylib"
macos.release.universal = "res://bin/libbenchmark_cpp.dylib"
